@page
@model MyBackend.Pages.IndexModel
@{
    ViewData["Title"] = "Latest Blogs";
    Layout = "_Layout";
}

<div class="hero-section animate-fade-in">
    <h2>Welcome to TechBlog</h2>
    <p class="subtitle">Read the latest insights and stories from our community.</p>
    
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="hero-actions" style="margin-top: 2rem;">
            <a href="/Auth" class="btn btn-primary">Join the Community</a>
        </div>
    }
</div>

<div class="blog-grid animate-slide-up" style="margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
    @if (Model.Blogs.Any())
    {
        foreach (var blog in Model.Blogs)
        {
            <div class="panel blog-card" style="display: flex; flex-direction: column;">
                <div class="panel-header" style="flex-direction: column; align-items: flex-start; gap: 0.5rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                    <h3 style="margin: 0; font-size: 1.25rem;">@blog.Title</h3>
                    <div style="font-size: 0.85rem; color: #a0aec0; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="user" style="width: 14px; height: 14px;"></i> @blog.Author?.Username
                        <span>&bull;</span>
                        <i data-lucide="calendar" style="width: 14px; height: 14px;"></i> @blog.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                </div>
                <div class="panel-body" style="flex: 1; margin-top: 1rem; color: #cbd5e1;">
                    @if (blog.Content.Length > 150)
                    {
                        <p>@blog.Content.Substring(0, 150)...</p>
                    }
                    else
                    {
                        <p>@blog.Content</p>
                    }
                </div>
                <div style="margin-top: 1.5rem;">
                    <a href="/Blog/Details?id=@blog.Id" class="btn btn-outline" style="width: 100%; justify-content: center;">Read More</a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="panel" style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem;">
            <div style="display: inline-block; padding: 1rem; background: rgba(56, 189, 248, 0.1); border-radius: 50%; color: #38bdf8; margin-bottom: 1rem;">
                <i data-lucide="book-open" style="width: 32px; height: 32px;"></i>
            </div>
            <h3>No blogs found</h3>
            <p style="color: #94a3b8; margin-top: 0.5rem;">Be the first to share your thoughts!</p>
        </div>
    }
</div>
