@page
@model MyBackend.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<section id="dashboard-section" class="dashboard-container animate-slide-up">
    <!-- User Welcome Bar -->
    <div class="welcome-bar" style="display: flex; justify-content: space-between; align-items: center; background: rgba(30,41,59,0.5); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem;">
        <div class="user-profile" style="display: flex; gap: 1rem; align-items: center;">
            <div class="user-avatar" style="width: 50px; height: 50px; background: #38bdf8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.25rem;">
                @(Model.Username.Substring(0, Math.Min(Model.Username.Length, 2)).ToUpper())
            </div>
            <div class="user-info">
                <h3 style="margin: 0; font-size: 1.5rem;">Welcome, @Model.Username!</h3>
                <p class="subtitle" style="margin: 0; color: #94a3b8;">@Model.Email @(Model.IsAdmin ? "(Admin)" : "")</p>
            </div>
        </div>
        
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-outline" style="border-color: #ef4444; color: #ef4444;">
                <i data-lucide="log-out"></i>
                <span>Sign Out</span>
            </button>
        </form>
    </div>

    @if (!Model.IsAdmin && !Model.IsApproved)
    {
        <div class="alert alert-warning" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); padding: 1rem; border-radius: 8px; color: #fcd34d; display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
            <i data-lucide="clock"></i>
            <div>
                <strong>Pending Approval:</strong> Your account is currently awaiting administrator approval. You cannot post blogs until approved.
            </div>
        </div>
    }

    @if (Model.IsAdmin)
    {
        <div class="panel" style="margin-bottom: 2rem;">
            <div class="panel-header">
                <i data-lucide="users" class="icon-accent"></i>
                <h2>User Management</h2>
            </div>
            <div class="log-table-wrapper">
                <table class="log-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="text-align: left; border-bottom: 1px solid rgba(255,255,255,0.1);">
                            <th style="padding: 1rem;">ID</th>
                            <th style="padding: 1rem;">Username</th>
                            <th style="padding: 1rem;">Email</th>
                            <th style="padding: 1rem;">Role</th>
                            <th style="padding: 1rem;">Status</th>
                            <th style="padding: 1rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td style="padding: 1rem;">@user.Id</td>
                                <td style="padding: 1rem;">@user.Username</td>
                                <td style="padding: 1rem;">@user.Email</td>
                                <td style="padding: 1rem;">@user.Role</td>
                                <td style="padding: 1rem;">
                                    @if (!user.IsActive) { <span style="color: #ef4444;">Deactivated</span> }
                                    else if (!user.IsApproved) { <span style="color: #f59e0b;">Pending</span> }
                                    else { <span style="color: #10b981;">Active & Approved</span> }
                                </td>
                                <td style="padding: 1rem; display: flex; gap: 0.5rem;">
                                    @if (user.Id != Model.UserId)
                                    {
                                        @if (!user.IsApproved)
                                        {
                                            <form method="post" asp-page-handler="ApproveUser" style="margin: 0;">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button class="btn btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Approve</button>
                                            </form>
                                        }
                                        @if (user.IsActive)
                                        {
                                            <form method="post" asp-page-handler="DeactivateUser" style="margin: 0;">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.875rem; border-color: #ef4444; color: #ef4444;">Deactivate</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="ActivateUser" style="margin: 0;">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.875rem; border-color: #10b981; color: #10b981;">Activate</button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <i data-lucide="book-open" class="icon-accent"></i>
                <h2 style="margin: 0;">@(Model.IsAdmin ? "All Blogs" : "Your Blogs")</h2>
            </div>
            @if (Model.IsAdmin || Model.IsApproved)
            {
                <a href="/Blog/CreateEdit" class="btn btn-primary">
                    <i data-lucide="plus"></i> Create Blog
                </a>
            }
        </div>
        <div class="log-table-wrapper">
            <table class="log-table" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="text-align: left; border-bottom: 1px solid rgba(255,255,255,0.1);">
                        <th style="padding: 1rem;">Title</th>
                        <th style="padding: 1rem;">Date</th>
                        @if (Model.IsAdmin) { <th style="padding: 1rem;">Author</th> }
                        <th style="padding: 1rem; width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Blogs.Any())
                    {
                        <tr>
                            <td colspan="4" style="padding: 2rem; text-align: center; color: #94a3b8;">No blogs found.</td>
                        </tr>
                    }
                    @foreach (var blog in Model.Blogs)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 1rem;">@blog.Title</td>
                            <td style="padding: 1rem;">@blog.CreatedAt.ToString("MMM dd, yyyy")</td>
                            @if (Model.IsAdmin) { <td style="padding: 1rem;">@blog.Author?.Username</td> }
                            <td style="padding: 1rem; display: flex; gap: 0.5rem;">
                                <a href="/Blog/Details?id=@blog.Id" class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">View</a>
                                @if (Model.IsAdmin || blog.AuthorId == Model.UserId)
                                {
                                    <a href="/Blog/CreateEdit?id=@blog.Id" class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.875rem;">Edit</a>
                                    <form method="post" asp-page-handler="DeleteBlog" onsubmit="return confirm('Are you sure you want to delete this blog?');" style="margin: 0;">
                                        <input type="hidden" name="id" value="@blog.Id" />
                                        <button class="btn btn-outline" style="padding: 0.25rem 0.75rem; font-size: 0.875rem; border-color: #ef4444; color: #ef4444;">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
